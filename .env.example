# Copy this file to .env and fill in real values. NEVER commit your real .env.
# Generate strong secrets, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-different-long-random-string
JWT_EXP_HOURS=12

# Database — local dev (matches docker-compose.yml's bundled postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=voting
DB_PASSWORD=votingpass
DB_NAME=votingdb
DB_SSLMODE=prefer
DB_POOL_MIN=1
DB_POOL_MAX=20

# Database — production (Supabase). Use these on the server instead of the
# local values above. Copy the exact host from the Supabase dashboard:
#   Project Settings -> Database -> Connect -> "Session pooler"
# (The pooler host is IPv4 and works from EC2; the direct db.<ref> host is IPv6-only.)
# DB_HOST=aws-1-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.dvhugchnksrgzwstyezn
# DB_PASSWORD=your-supabase-database-password
# DB_NAME=postgres
# DB_SSLMODE=require

# App
PORT=8000
FLASK_DEBUG=0

# Optional: shared rate-limit storage for multi-worker deployments
# RATELIMIT_STORAGE_URI=redis://localhost:6379
